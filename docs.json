{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Escape Director",
  "description": "Help center for Escape Director, the escape room software for running live games, sending Clues, showing Live View, connecting props, and tracking results.",
  "colors": {
    "primary": "#DD3333",
    "light": "#E76F6F",
    "dark": "#B82A2A"
  },
  "background": {
    "color": {
      "dark": "#060404"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.escapedirector.com"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Join our Discord",
        "href": "https://discord.gg/tRDXj9x6SF"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://www.escapedirector.com/sign-in"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp"
    ]
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.escapedirector.com",
      "og:site_name": "Escape Director"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Help center",
        "icon": "life-ring",
        "groups": [
          {
            "group": "Welcome",
            "icon": "house",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "get-started/getting-started",
              "get-started/create-your-account-and-sign-in",
              "get-started/start-your-trial-and-activate-your-plan",
              "get-started/create-and-configure-your-first-room"
            ]
          },
          {
            "group": "Build your Rooms",
            "icon": "hammer",
            "pages": [
              "build-your-rooms/build-your-rooms",
              "build-your-rooms/configure-live-view",
              "build-your-rooms/add-puzzles-and-clues",
              "build-your-rooms/manage-room-media",
              "build-your-rooms/configure-room-automations",
              "build-your-rooms/connect-room-devices",
              "build-your-rooms/connect-existing-devices",
              "build-your-rooms/build-your-own-controller"
            ]
          },
          {
            "group": "Prepare for a shift",
            "icon": "clipboard-check",
            "pages": [
              "prepare-for-a-shift/prepare-for-a-shift",
              "prepare-for-a-shift/manage-game-masters",
              "prepare-for-a-shift/prepare-your-room-station"
            ]
          },
          {
            "group": "Run a session",
            "icon": "play",
            "pages": [
              "run-a-session/run-a-session",
              "run-a-session/run-a-live-session",
              "run-a-session/live-session-quick-reference",
              "run-a-session/troubleshoot-a-live-session"
            ]
          },
          {
            "group": "Review and improve",
            "icon": "chart-line",
            "pages": [
              "review-and-improve/review-and-improve",
              "review-and-improve/view-room-statistics",
              "review-and-improve/use-analytics",
              "review-and-improve/manage-leaderboards"
            ]
          },
          {
            "group": "Account and help",
            "icon": "circle-user",
            "pages": [
              "account-and-help/account",
              "account-and-help/use-account-settings",
              "account-and-help/manage-locations",
              "account-and-help/add-managers-and-room-stations",
              "account-and-help/help",
              "account-and-help/common-questions"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "icon": "code",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "developers/overview",
              "developers/quickstart",
              "developers/build-with-a-coding-agent"
            ]
          },
          {
            "group": "Build your prop",
            "icon": "microchip",
            "pages": [
              "developers/add-the-sdk-to-your-sketch",
              "developers/example-sketches",
              "developers/troubleshoot-your-firmware"
            ]
          },
          {
            "group": "Reference",
            "icon": "book",
            "pages": [
              "developers/room-api-reference",
              "developers/supported-boards",
              "developers/add-a-board-adapter"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/tRDXj9x6SF",
      "website": "https://www.escapedirector.com"
